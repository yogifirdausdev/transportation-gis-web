# Application
NUXT_PUBLIC_APP_NAME="Peta Perlengkapan Jalan"
# Sub-path the app is served under, with leading and trailing slash, e.g. /peta-perlengkapan-jalan/
NUXT_APP_BASE_URL=/

# Authentication
NUXT_SESSION_SECRET=replace-with-a-long-random-secret
NUXT_ADMIN_EMAIL=admin@gis.local
NUXT_ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL
POSTGRES_DB=gis
POSTGRES_USER=gis
# Use letters and numbers only (e.g. openssl rand -hex 24): it is placed inside the database URL.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# docker-compose builds NUXT_DATABASE_URL from the three values above.

# Storage
NUXT_STORAGE_DIR=/app/storage
